<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>891edb97-dce1-41ae-90e0-a870cf58d305</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Con Central Package Management las versiones viven en Directory.Packages.props -->
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.File" />
    <!-- Provider EF Core: el composition root llama UseNpgsql; referencia directa para unificar
         la versión de EF Core con core/ (vía ProjectReference se resolvía a la mínima del rango). -->
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <!-- Requerido por dotnet ef (migrations/database) cuando backend es el startup project. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!-- Validación de DTOs (UC-07). -->
    <PackageReference Include="FluentValidation.AspNetCore" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\core\Niuro.Core.csproj" />
  </ItemGroup>

</Project>
